# SITE
# Public address, used for canonical URLs, social cards, sitemap and llms.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SUPABASE
SUPABASE_SECRET_KEY=
SUPABASE_DB_URI=

# LLM 
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.5-flash
# REPORT STORAGE
# Encrypts reports saved to the cloud. Generate with: openssl rand -base64 32
REPORT_ENCRYPTION_KEY=

# BACHS PAYMENTS
# Sandbox: https://sandbox-api.bachs.io with an sk_sandbox_ key.
# Live: https://api.bachs.io with an sk_live_ key.
BACHS_API_URL=https://sandbox-api.bachs.io
BACHS_API_KEY=
# Signing secret of the webhook pointed at <site>/api/webhooks/bachs.
BACHS_WEBHOOK_SECRET=
# Product ids from the Bachs dashboard, one per purchase.
BACHS_PRODUCT_REPORT=
BACHS_PRODUCT_PRO_MONTHLY=
BACHS_PRODUCT_PRO_YEARLY=
BACHS_PRODUCT_BUSINESS_MONTHLY=
BACHS_PRODUCT_BUSINESS_YEARLY=

# LOAD TEST (npm run loadtest)
# A test account on the Business plan: npm run grant -- <email> business
LOADTEST_EMAIL=
LOADTEST_PASSWORD=
